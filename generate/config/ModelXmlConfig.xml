<?xml version="1.0" encoding="UTF-8"?>
<XGenConfig>
    <Model namespaceAware="true">
        <ModelNamespaces>
            <ModelNamespace prefix="a" namespace="attribute" />
            <ModelNamespace prefix="c" namespace="collection" />
            <ModelNamespace prefix="o" namespace="object" />
            <ModelNamespace prefix="xi" namespace="http://www.w3.org/2001/XInclude" />
        </ModelNamespaces>
    </Model>

    <XmlTemplate rootSectionName="Model">
        <FileFormat commentNodeXPath="@XGAnnotation" childAccessor="_" currentAccessor="-" />
        <Output type="output_per_element" />
    </XmlTemplate>

    <Binding>
        <SectionModelBinding section="Model" modelXPath="/Model/RootObject/Children/Model">
            <SectionModelBinding section="Package" modelXPath="Packages/Package">
                <SectionModelBinding section="Entity" modelXPath="Entities/Entity">
                    <SectionModelBinding section="Attribute" modelXPath="Attributes/EntityAttribute">
                    </SectionModelBinding>
                </SectionModelBinding>
            </SectionModelBinding>
        </SectionModelBinding>
    </Binding>
</XGenConfig>