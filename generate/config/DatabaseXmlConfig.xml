<?xml version="1.0" encoding="UTF-8"?>
<XGenConfig>
    <Model  />

    <XmlTemplate rootSectionName="Database">
        <Output type="output_per_element" />
        <XmlSections>
            <XmlSection name="Schema" templateXPath="/Project/ItemGroup/Folder[starts-with(@Include,'Schema')]" />
            <XmlSection name="Ignore" templateXPath="/Project/ItemGroup/*[starts-with(@Include,'Ignore')]" />
            <XmlSection name="Schema" templateXPath="/Project/ItemGroup/Build[ends-with(@Include,'Schema_Code.sql')]" />
            <XmlSection name="Table" templateXPath="/Project/ItemGroup/Build[contains(@Include,'Table')]" />
        </XmlSections>
    </XmlTemplate>

    <Binding>
        <SectionModelBinding section="Database" modelXPath="/Database">
            <SectionModelBinding section="Schema" modelXPath="Schemas/Schema"/>
            <SectionModelBinding section="Table" modelXPath="Schemas/Schema/Tables/Table">
                <Placeholders>
                    <Placeholder name="Schema" modelXPath="../.."/>
                </Placeholders>
            </SectionModelBinding>
            <SectionModelBinding section="Ignore" modelXPath=".[0 = 1]"/>
        </SectionModelBinding>
    </Binding>
</XGenConfig>